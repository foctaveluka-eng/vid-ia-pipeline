# ============================================================
# VID IA PIPELINE — Variables d'environnement
# ============================================================
# INSTRUCTIONS :
#   1. Copiez ce fichier et renommez-le ".env" (en local seulement)
#   2. Remplissez chaque valeur avec vos vraies clés
#   3. Ne committez JAMAIS le fichier ".env" sur GitHub !
#   4. Pour GitHub Actions → ajoutez ces valeurs dans :
#      Settings → Secrets and variables → Actions
# ============================================================

# ── Google OAuth2 ──────────────────────────────────────────
GOOGLE_CLIENT_ID=votre_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-votre_client_secret
GOOGLE_REFRESH_TOKEN=1//votre_refresh_token_permanent

# ── APIs de Génération ──────────────────────────────────────
# API Delfa pour la génération de scripts et titres
DELFA_API_URL=https://delfaapiai.vercel.app/ai/copilot

# API de génération d'images
IMAGE_API_URL=https://gem-tw6a.onrender.com/generate

# ── Format éditorial (optionnel) ───────────────────────────
# Laissez vide pour choisir selon l'heure Europe/Paris.
# Valeurs : dessin_anime, actualites, horreur, manga
PIPELINE_THEME=

# ── Manga ──────────────────────────────────────────────────
# Nombre de scènes par épisode manga (24 à 120, 48 par défaut)
MANGA_SEGMENTS=48

# Premier jour de publication de la série manga (numérote un épisode par jour)
MANGA_SERIES_START_DATE=2026-07-24

# ── Dessin animé ───────────────────────────────────────────
# Nombre de scènes par épisode dessin animé (16 à 48, 24 par défaut)
CARTOON_SEGMENTS=24

# Premier jour de publication de la série dessin animé (numérote un épisode par jour)
CARTOON_SERIES_START_DATE=2026-07-24

# ── Mode de test ───────────────────────────────────────────
TEST_MODE=false
